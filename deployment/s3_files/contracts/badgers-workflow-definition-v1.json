{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "badgers-workflow-definition/v1",
  "title": "BADGERS Workflow Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "supported_routing_modes",
    "invariants",
    "invariant_capabilities",
    "routing_policy_id",
    "allowed_capabilities",
    "result_contract"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "display_name": { "type": "string", "maxLength": 256 },
    "supported_routing_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["auto", "manual"] }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_/-]{0,127}$" }
    },
    "invariant_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,127}$"
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_source_types", "requires_document_uri"],
      "properties": {
        "accepted_source_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "requires_document_uri": { "const": true }
      }
    },
    "routing_policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" }
    },
    "manual_capability_selection_allowed": { "type": "boolean", "default": false },
    "result_contract": { "const": "badgers-operation-result/v1" }
  }
}

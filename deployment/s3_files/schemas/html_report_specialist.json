[
  {
    "name": "generate_html_report_tool",
    "description": "Generates one document-level BADGERS HTML analysis and audit report after every page has a canonical BADGERS spine. A spine may come from native PDF parsing, native DOCX parsing, Textract OCR, or visual correlation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_document_path": {
          "type": "string",
          "description": "S3 URI of the source PDF, image, or DOCX document"
        },
        "document_title": {
          "type": "string",
          "description": "Optional human-readable report title"
        },
        "expected_page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "description": "Page count returned by the document converter or DOCX page plan"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "description": "Ordered pages to include in the document report",
          "items": {
            "type": "object",
            "properties": {
              "page_number": {
                "type": "string"
              },
              "correlation_specialist_uri": {
                "type": "string"
              },
              "canonical_spine_uri": {
                "type": "string",
                "description": "Schema-valid native PDF, Textract OCR, or visual correlation spine."
              },
              "source_image_path": {
                "type": "string"
              },
              "processing_mode": {
                "type": "string",
                "enum": ["native_pdf", "native_docx", "textract_ocr", "hybrid", "vision_ai"],
                "description": "Native PDF and DOCX pages have no source image. Textract OCR pages use an accepted canonical spine and retain their page image. Hybrid and vision_ai pages require a correlation spine and image."
              }
            },
            "required": [
              "page_number",
              "correlation_specialist_uri"
            ]
          }
        },
        "session_id": {
          "type": "string",
          "description": "Runtime session ID"
        },
        "job_id": {
          "type": "string",
          "description": "Injected analysis job ID"
        },
        "doc_id": {
          "type": "string",
          "description": "Injected document ID"
        },
        "user_id": {
          "type": "string",
          "description": "Injected authenticated Cognito subject or local identity"
        },
        "user_name": {
          "type": "string",
          "description": "Injected authenticated username or local"
        }
      },
      "required": [
        "source_document_path",
        "expected_page_count",
        "pages",
        "session_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "html_report_uri": {
          "type": "string"
        },
        "report_manifest_uri": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "page_count": {
          "type": "integer"
        },
        "success": {
          "type": "boolean"
        },
        "session_id": {
          "type": "string"
        }
      }
    }
  }
]

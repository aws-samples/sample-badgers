# Local UI env files are already covered by the .env rule above. They are generated by
# deployment/update_frontend_env.sh and deployment/scripts/generate_ui_env.sh.
.favicon
logo.png

# Custom specialists - keep directory structure only
deployment/custom_specialists/*
!deployment/custom_specialists/.gitkeep

# Hidden dot-directories (repo-wide)
.**/
!.github/

# Security scan reports
.security-reports/

# Local scanner configs (bandit / checkov exclusions) - not shared
.checkov.yaml
bandit.yaml

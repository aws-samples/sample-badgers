# Custom
.DS_store
deployment/cdk.out/
layer/
*.zip

# Shared modules staged into container build contexts by the build scripts.
# Docker cannot COPY from outside the build context, so foundation/ and config/
# are copied in before `docker build`. The originals live in
# deployment/lambdas/layer/python/.
deployment/lambdas/containers/*/foundation/
deployment/lambdas/containers/*/config/

# Same staging for the AgentCore Runtime image, which imports foundation.job_state
# to create the job-level record. Copied by build_and_push_websocket.sh from
# deployment/badgers-foundation/foundation/.
deployment/runtime/agent/foundation/

# GIT
../.pre-commit-config.yaml

# CDK
cdk.out/
cdk.context.json

# CDK asset staging
.cdk.staging/

# CDK Toolkit outputs
*.js.map
.d.ts

